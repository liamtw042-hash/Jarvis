# ============================================================
#  JARVIS — Environment Configuration
#  Copy this file to .env and fill in your keys.
#  Never commit your .env file to version control.
# ============================================================

# ── REQUIRED ────────────────────────────────────────────────
# Claude AI — the brain of JARVIS
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI Whisper — speech-to-text transcription
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs — British voice output
# Get your key at: https://elevenlabs.io/  (free tier available)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── OPTIONAL: ElevenLabs Voice ──────────────────────────────
# Default is Daniel (British male).
# Find voice IDs at: https://elevenlabs.io/voice-library
# Popular British voices:
#   Daniel  : onwK4e9ZLuTAKqWW03F9  (deep, authoritative)
#   George  : JBFqnCBsd6RMkjVDRZzb  (warm, British)
#   Antoni  : ErXwobaYiN019PkySvjV  (clear, British)
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# ── OPTIONAL: Weather ───────────────────────────────────────
# OpenWeatherMap — free tier at: https://openweathermap.org/api
# If not set, uses the free wttr.in service instead.
OPENWEATHER_API_KEY=your_openweathermap_key_here

# Location for weather (default: Newcastle, AU)
WEATHER_CITY=Newcastle
WEATHER_COUNTRY=AU

# ── OPTIONAL: News ──────────────────────────────────────────
# NewsAPI.org — free tier at: https://newsapi.org/
# If not set, uses the free BBC News RSS feed instead.
NEWS_API_KEY=your_newsapi_key_here
NEWS_COUNTRY=gb
NEWS_CATEGORY=general

# ── OPTIONAL: Forex ─────────────────────────────────────────
# Alpha Vantage — free tier (25 req/day) at: https://www.alphavantage.co/
# If not set, uses the free Open Exchange Rates API instead.
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here

# ── OPTIONAL: Email ─────────────────────────────────────────
# Gmail: use an App Password (NOT your real password).
# Enable at: https://myaccount.google.com/apppasswords
# For Outlook: use your regular password with imap-mail.outlook.com
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993

# ── OPTIONAL: Advanced ──────────────────────────────────────
# Override the Claude model (default: claude-sonnet-4-6)
# Options: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# Override local Whisper model size (if using offline mode, no OPENAI_API_KEY)
# Options: tiny, base, small, medium, large  (larger = more accurate, slower)
WHISPER_LOCAL_MODEL=base
